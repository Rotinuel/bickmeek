# ── Required ────────────────────────────────────────────────
# MongoDB connection string (MongoDB Atlas recommended for Vercel).
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/bicemeek?retryWrites=true&w=majority"

# Public address of the site, no trailing slash. Used for canonical URLs, sitemap and social cards.
PUBLIC_SITE_URL="https://www.bicemeek.com"

# ── First admin account ─────────────────────────────────────
# On first start, if no admin exists, one is created from these two values.
# Use a strong password (12+ characters). After you sign in, change the password
# in Admin → Settings and remove ADMIN_PASSWORD from your environment.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-to-a-long-password"
ADMIN_NAME="BiceMeek Admin"

# ── Media storage ───────────────────────────────────────────
# gridfs  → stores uploads inside MongoDB (default, no extra service)
# blob    → Vercel Blob (best for large videos on Vercel; needs BLOB_READ_WRITE_TOKEN)
# local   → ./uploads folder on disk (local development only)
STORAGE_DRIVER="gridfs"
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./uploads"

# ── Optional: Google ────────────────────────────────────────
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Analytics stays off when empty.
PUBLIC_GA_MEASUREMENT_ID=""
# Google Search Console HTML-tag verification code (content="..." value only).
PUBLIC_GOOGLE_SITE_VERIFICATION=""
